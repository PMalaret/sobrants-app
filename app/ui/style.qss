* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget {
    background-color: #f5f6f8;
}

QTabWidget::pane {
    border: 1px solid #d0d3d9;
    background: #ffffff;
}

QTabBar::tab {
    background: #e8eaee;
    padding: 8px 18px;
    border: 1px solid #d0d3d9;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    font-weight: 600;
}

QGroupBox {
    border: 1px solid #d0d3d9;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    background: #ffffff;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QTableWidget {
    background: #ffffff;
    gridline-color: #e2e4e8;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
    alternate-background-color: #fafbfc;
}

QHeaderView::section {
    background-color: #eef0f3;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #d0d3d9;
    font-weight: 600;
}

QPushButton {
    background-color: #2f6fed;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2559c9;
}

QPushButton:pressed {
    background-color: #1e47a3;
}

QLineEdit, QSpinBox {
    border: 1px solid #c7cad1;
    border-radius: 4px;
    padding: 5px 7px;
    background: #ffffff;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #2f6fed;
}

QStatusBar {
    background: #eef0f3;
    border-top: 1px solid #d0d3d9;
}

QMenuBar {
    background-color: #f5f6f8;
    color: #1a1a1a;
}

QMenuBar::item {
    background: transparent;
    color: #1a1a1a;
    padding: 4px 10px;
}

/* Al pasar el ratón sólo cambia el fondo; el texto se queda siempre oscuro
   (si no se fija "color" aquí, algunos estilos de plataforma lo ponen
   blanco y se vuelve ilegible sobre un fondo claro). */
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #d8e2fb;
    color: #1a1a1a;
}

QMenu {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d0d3d9;
}

QMenu::item {
    padding: 6px 24px 6px 14px;
    color: #1a1a1a;
}

QMenu::item:selected {
    background-color: #d8e2fb;
    color: #1a1a1a;
}
