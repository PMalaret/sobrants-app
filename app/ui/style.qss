/* Full d'estil global de l'aplicació.
 *
 * Els colors no s'escriuen aquí: hi van els NOMS de la paleta
 * (`app/ui/theme.py`), que es substitueixen en carregar el fitxer
 * (`theme.stylesheet()`). Així el mateix full serveix per a qualsevol
 * paleta i no hi ha cap codi de color repetit en dos llocs.
 *
 * Les mides (mides de lletra, marges, radis) sí que són literals: no
 * depenen de la paleta.
 *
 * UNA REGLA QUE NO S'HA DE TRENCAR: aquí no hi pot haver cap regla
 * `QTableView::item` / `QTableWidget::item`. En donar estil als ítems,
 * Qt es fa càrrec de pintar-los i deixa d'aplicar el color de fons que
 * posa el codi a cada cel·la — i en aquesta aplicació aquell color és
 * informació (com d'ocupada està una posició, quines cel·les ha trobat
 * un cercador), no decoració. L'aire de les files es dona amb l'alçada
 * de fila des del codi, mai des d'aquí.
 */

* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget {
    background-color: $window;
}

QTabWidget::pane {
    border: none;
    background: $surface;
}

/* Pestanyes sense caixa: la seleccionada es marca amb un subratllat del
   color d'acció i el text del mateix color, no amb una vora al voltant.
   El text de les no seleccionades es queda ben fosc (no gris clar): en un
   monitor de taller, amb llum de sobres, un gris suau no es llegeix. */
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 7px 18px;
    margin-right: 2px;
    color: $text_secondary;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: $text;
    background: $surface_alt;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    color: $accent;
    border-bottom: 3px solid $accent;
}

/* MainWindow no fa servir QTabWidget (les pestanyes i el total de peces
   comparteixen una sola fila amb QTabBar solt): la separació sota la
   barra de pestanyes es fa amb una línia fina, no amb un marc. */
QStackedWidget#tabStack {
    border: none;
    border-top: 1px solid $border;
    background: $surface;
}

QGroupBox {
    border: 1px solid $grid;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 12px 10px 12px;
    background: $surface;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: $text_secondary;
}

QTableWidget, QTableView {
    background: $surface;
    gridline-color: $grid;
    border: none;
    /* Selecció ben visible (fons ple del color d'acció, text a sobre en
       clar): en un taller ha de quedar clar quina línia està triada. */
    selection-background-color: $accent;
    selection-color: $on_accent;
    alternate-background-color: $row_alt;
}

/* Capçalera amb un fons una mica més fosc que la taula, perquè es
   distingeixi del contingut d'un cop d'ull, però plana: sense vores
   verticals ni relleu, només la línia de sota. El text, fosc, per
   llegir-la de lluny. */
QHeaderView::section {
    background-color: $surface_alt;
    color: $text;
    padding: 7px 4px;
    border: none;
    border-bottom: 1px solid $border;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: $accent;
}

/* El fons del WIDGET capçalera (no de les seccions) es queda blanc: és el
   que es veu més enllà de l'última columna i sota l'últim número de fila, i
   amb el gris de les seccions quedaria una franja grisa buida al costat
   d'una taula amb poques línies. */
QHeaderView {
    background: $surface;
    border: none;
}

/* La capçalera vertical són els números de fila: la mateixa línia fina que
   la reixa, i el pes del text normal — no és un títol de columna. */
QHeaderView::section:vertical {
    color: $text_muted;
    font-weight: 400;
    padding: 2px 8px;
    border: none;
    border-bottom: 1px solid $border;
    border-right: 1px solid $border;
}

/* Barres de desplaçament primes i sense fletxes, però NO tan primes com
   es porta: 14 px perquè es puguin agafar amb el ratolí sense apuntar
   fi (i amb guants, o en una pantalla tàctil, encara més). */
QScrollBar:vertical {
    background: transparent;
    width: 14px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 14px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 7px;
    min-height: 40px;
    min-width: 40px;
}

QScrollBar::handle:hover {
    background: $text_muted;
}

QScrollBar::handle:pressed {
    background: $accent;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ------------------------------------------------------------------ *
 * Botons: una sola família, amb dues propietats.
 *
 *   variant = (res) | "ghost" | "danger"   -> quin pes visual té
 *   compact = "true"                        -> més estret, per als llocs
 *                                              on l'espai va just
 *
 * Es posen des del codi amb `setProperty`, mai amb un color escrit a mà
 * al widget: així tots els botons de l'aplicació tenen la mateixa forma,
 * la mateixa alçada i els mateixos estats.
 *
 * La vora hi és sempre (transparent quan no es veu) perquè el botó no
 * canviï de mida en passar a desactivat, que sí que en porta.
 * ------------------------------------------------------------------ */
QPushButton {
    background-color: $accent;
    color: $on_accent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: $accent_hover;
}

QPushButton:pressed {
    background-color: $accent_pressed;
}

QPushButton[compact="true"] {
    padding: 5px 12px;
    min-height: 16px;
    font-size: 12px;
    border-radius: 7px;
}

QPushButton[variant="danger"] {
    background-color: $danger;
    color: $on_accent;
}

QPushButton[variant="danger"]:hover {
    background-color: $danger_hover;
}

QPushButton[variant="danger"]:pressed {
    background-color: $danger_pressed;
}

/* Botó secundari (`setProperty("variant", "ghost")`): mateixa forma i
   mateixa mida que un de normal, però sense omplir-lo de color. Serveix
   per als botons que acompanyen l'acció principal —els intervals fets de
   les estadístiques, al costat de "Consultar"—, perquè es vegi d'un cop
   d'ull quin és el botó important de la fila. */
QPushButton[variant="ghost"] {
    background-color: transparent;
    color: $text;
    border: 1px solid $border;
}

QPushButton[variant="ghost"]:hover {
    background-color: $surface_alt;
    border-color: $text_muted;
}

QPushButton[variant="ghost"]:pressed {
    background-color: $accent_soft;
}

QPushButton[variant="ghost"]:disabled {
    background-color: transparent;
    color: $text_disabled;
    border-color: $disabled_bg;
}

/* Desactivat: com que el botó té aquí un fons fix, Qt ja no li aplica el
   gris que posaria l'estil natiu i, sense aquesta regla, es veuria igual
   que un d'actiu. Es marca amb un fons clar i una vora fina —no amb un
   bloc gris ple, que pesa massa i s'assembla a un botó de fa trenta
   anys—, i el text i la icona passen al gris de desactivat. */
QPushButton:disabled, QPushButton[variant="danger"]:disabled {
    background-color: $surface_alt;
    color: $text_disabled;
    border: 1px solid $border;
}

/* Radios i caselles: a alguns temes de Windows la marca de seleccionat
   gairebé no es veu (i encara menys amb un full d'estil pel mig), de manera
   que es pinta aquí, explícitament, en comptes de dependre del sistema.
   Segueixen sent radios i caselles de veritat: només se'n canvia l'aspecte,
   no el comportament ni l'accessibilitat. */
QRadioButton, QCheckBox {
    spacing: 8px;
    color: $text;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: $surface;
    border: 2px solid $text_muted;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: $accent;
}

/* Seleccionat: vora del color d'acció i un punt ben visible a dins. */
QRadioButton::indicator:checked {
    border: 2px solid $accent;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                                      fx:0.5, fy:0.5,
                                      stop:0 $accent, stop:0.5 $accent,
                                      stop:0.55 $surface, stop:1 $surface);
}

QCheckBox::indicator:checked {
    border: 2px solid $accent;
    background-color: $accent;
    image: none;
}

QRadioButton::indicator:disabled, QCheckBox::indicator:disabled {
    border-color: $disabled_bg;
    background-color: $surface_alt;
}

/* Camps de text, números i dates: cantonada arrodonida i, en tenir el
   focus, una vora del color d'acció més gruixuda. El "padding" baixa un
   píxel quan la vora en puja un, així el camp no fa cap salt en clicar-hi. */
QLineEdit, QSpinBox, QDateEdit, QComboBox {
    border: 1px solid $border;
    border-radius: 8px;
    padding: 7px 10px;
    background: $surface;
    color: $text;
    selection-background-color: $accent;
    selection-color: $on_accent;
}

QLineEdit:hover, QSpinBox:hover, QDateEdit:hover, QComboBox:hover {
    border-color: $text_muted;
}

QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid $accent;
    padding: 6px 9px;
}

QLineEdit:disabled, QSpinBox:disabled, QDateEdit:disabled {
    background: $surface_alt;
    color: $text_disabled;
}

/* Sense fletxes amunt/avall als camps numèrics: el valor es continua
   podent canviar escrivint-lo o amb les fletxes del teclat. */
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

QDateEdit::drop-down, QComboBox::drop-down {
    border: none;
    width: 22px;
}

QStatusBar {
    background: $window;
    border: none;
    color: $text_secondary;
}

QStatusBar::item {
    border: none;   /* sense les vores de separació que hi posa Qt */
}

QToolTip {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 5px 8px;
}

QMenuBar {
    background-color: $window;
    color: $text;
    border: none;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    color: $text;
    padding: 6px 12px;
    border-radius: 6px;
}

/* Al passar el ratolí només canvia el fons; el text es queda sempre amb el
   color de text normal (si no es fixa "color" aquí, alguns estils de
   plataforma el posen blanc i es torna il·legible sobre un fons clar). */
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: $accent_soft;
    color: $text;
}

QMenu {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 6px;
    color: $text;
}

QMenu::item:selected {
    background-color: $accent_soft;
    color: $text;
}

/* Mateix motiu que a QPushButton: el color fix de QMenu::item també
   s'aplicava a les opcions desactivades (p. ex. "Esborrar aquesta peça"
   sobre una peça que no és l'última), i no es distingien de les actives. */
QMenu::item:disabled {
    color: $text_disabled;
}

QMenu::separator {
    height: 1px;
    background: $border;
    margin: 5px 8px;
}
